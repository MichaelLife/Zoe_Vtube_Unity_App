            <ui:Slider label="Open Threshold" value="42" high-value="1" name="EyeOpen" focusable="false" class="Slider" style="background-color: rgba(59, 21, 91, 0.5); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; color: rgb(255, 255, 255); flex-shrink: 1;"/>
            <ui:Slider label="Eye Deadzone" value="42" high-value="20" name="Deadzone" focusable="false" class="Slider" style="background-color: rgba(59, 21, 91, 0.5); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; color: rgb(255, 255, 255); flex-direction: row; flex-shrink: 1;"/>
