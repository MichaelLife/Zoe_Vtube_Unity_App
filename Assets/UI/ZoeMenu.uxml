    <ui:VisualElement name="ZoeUI" enabled="true" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); align-items: stretch; flex-direction: row; display: flex; flex-basis: auto; flex-wrap: nowrap;">
        <ui:VisualElement name="EYES" style="flex-grow: 1; background-color: rgba(123, 94, 195, 0.42); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-image: url(&quot;project://database/Assets/ZOE/Textures/Purple%20Nebula%206%20-%201024x1024.png?fileID=2800000&amp;guid=8a0d716c0be3422489cb3ed1a29b3d32&amp;type=3#Purple Nebula 6 - 1024x1024&quot;); background-repeat: no-repeat no-repeat; -unity-background-image-tint-color: rgba(255, 255, 255, 0.47); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-left-color: rgb(255, 231, 96); border-right-color: rgb(255, 231, 96); border-top-color: rgb(255, 231, 96); border-bottom-color: rgb(255, 231, 96); align-items: stretch; justify-content: space-between; align-self: auto;">
            <ui:Label text="EYES" class="Label" style="-unity-text-align: lower-center; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 0; background-color: rgb(68, 45, 102); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; white-space: pre; text-overflow: clip; width: 33%; justify-content: center; align-items: center; align-self: center; flex-shrink: 1; flex-grow: 1;"/>
            <ui:Button text="Reset Eye Rotation" name="ResetEyeRot" class="Button"/>
            <ui:Slider label="Blink Threshold" value="42" high-value="1" name="Blink" focusable="false" fill="false" class="Slider" style="background-color: rgba(59, 21, 91, 0.5); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; color: rgb(255, 255, 255); flex-shrink: 1; -unity-text-align: middle-left;"/>
